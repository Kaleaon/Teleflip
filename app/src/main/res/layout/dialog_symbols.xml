<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark_card"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_symbols_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Page 1/4 (1-9)"
        android:textColor="@color/focus_highlight_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/softkey_divider"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_symbols_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="260dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/softkey_divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <include layout="@layout/layout_softkeys" />

</LinearLayout>
