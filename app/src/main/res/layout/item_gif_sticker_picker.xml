<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_picker_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:layout_margin="2dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:background="@drawable/bg_item_selector">

    <ImageView
        android:id="@+id/iv_picker_thumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:contentDescription="Picker item thumbnail" />

    <TextView
        android:id="@+id/tv_picker_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_picker_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingTop="2dp" />

</LinearLayout>
