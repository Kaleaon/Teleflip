<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Configuration"
            android:textColor="@color/tg_blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_item_selector"
            android:padding="12dp"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_settings_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account: Not logged in"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- API ID Setting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Telegram API ID:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_input_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[#] 123"
                android:textColor="@color/focus_highlight_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_api_id"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="e.g. 21724"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_edittext_selector"
            android:inputType="number"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="12dp" />

        <!-- API HASH Setting -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telegram API Hash:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_api_hash"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="e.g. 3e0cb5da..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_edittext_selector"
            android:inputType="text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="12dp" />

        <!-- Keypad Timeout Setting -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi-tap Timeout:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/sp_keypad_timeout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_edittext_selector"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="12dp" />

        <!-- Closed Flip-Phone Background Push / Polling Toggle -->
        <Button
            android:id="@+id/btn_toggle_bg_notifications"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🔔 Closed-Flip Background Push: ON"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Edit Profile Button -->
        <Button
            android:id="@+id/btn_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="👤 Edit Profile (Name, Bio, Username)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Active Sessions & Security Button -->
        <Button
            android:id="@+id/btn_active_sessions"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="📱 Active Sessions &amp; Devices"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Blocked Users Button -->
        <Button
            android:id="@+id/btn_blocked_users"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🚫 Blocked Users"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- App Passcode Lock Button -->
        <Button
            android:id="@+id/btn_passcode_lock"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🔒 App Passcode Lock: OFF"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Proxy Server Settings Button -->
        <Button
            android:id="@+id/btn_proxy_settings"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🌐 Proxy Settings: Disabled"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Storage Location (Internal vs SD Card) -->
        <Button
            android:id="@+id/btn_storage_location"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="💾 Storage Location: Internal Storage"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Auto-Download Media Setting -->
        <Button
            android:id="@+id/btn_auto_download"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="📥 Auto-Download: Wi-Fi Only"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Keep Media Duration Setting -->
        <Button
            android:id="@+id/btn_keep_media"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="⏳ Keep Media: Forever"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Save Media to Public Downloads Setting -->
        <Button
            android:id="@+id/btn_save_to_gallery"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="📁 Save Media to Downloads: OFF"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Clear Media Cache Button -->
        <Button
            android:id="@+id/btn_clear_cache"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🧹 Clear Local Media Cache"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="14dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_config"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Save &amp; Reconnect"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Log Out Button -->
        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Log Out"
            android:textColor="@color/text_error"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Back to Chats Button -->
        <Button
            android:id="@+id/btn_back_to_chats"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Back"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
