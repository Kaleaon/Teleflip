<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Header / Encryption Notice -->
        <TextView
            android:id="@+id/tv_call_encryption_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 End-to-End Encrypted Telegram Call"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Caller Avatar -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_call_avatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_teleflip_logo"
                android:contentDescription="Caller Avatar" />

            <TextView
                android:id="@+id/tv_call_avatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Caller Name -->
        <TextView
            android:id="@+id/tv_call_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Call Status / Timer -->
        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calling..."
            android:textColor="@color/text_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Status Indicators -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_call_mute_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤 Mic: On"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tv_call_speaker_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔈 Earpiece"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Call Buttons (D-Pad Navigable) -->
        <LinearLayout
            android:id="@+id/layout_call_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btn_call_accept"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📞 Accept Call"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_call_mute"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Mute Mic"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_selector"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_call_speaker"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Speaker"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_selector"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_call_end"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="❌ End Call"
                android:textColor="@color/text_error"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
