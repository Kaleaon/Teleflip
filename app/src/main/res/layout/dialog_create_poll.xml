<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tv_poll_step_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 Create Poll (Step 1/2)"
                android:textColor="@color/focus_highlight_gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_poll_input_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[#] Abc"
                android:textColor="@color/focus_highlight_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/softkey_divider"
            android:layout_marginBottom="8dp" />

        <!-- STEP 1 CONTAINER: Question & Options -->
        <LinearLayout
            android:id="@+id/layout_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <com.teleflip.app.ui.LabeledInputView
                android:id="@+id/liv_poll_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:inputLabel="Poll Question:"
                app:inputHint="Ask a question..."
                app:inputSingleLine="true" />

            <com.teleflip.app.ui.LabeledInputView
                android:id="@+id/liv_poll_opt1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:inputLabel="Options (at least 2):"
                app:inputHint="Option 1"
                app:inputSingleLine="true" />

            <com.teleflip.app.ui.LabeledInputView
                android:id="@+id/liv_poll_opt2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:inputHint="Option 2"
                app:inputSingleLine="true" />

            <com.teleflip.app.ui.LabeledInputView
                android:id="@+id/liv_poll_opt3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:inputHint="Option 3 (optional)"
                app:inputSingleLine="true" />

            <com.teleflip.app.ui.LabeledInputView
                android:id="@+id/liv_poll_opt4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:inputHint="Option 4 (optional)"
                app:inputSingleLine="true" />

            <Button
                android:id="@+id/btn_poll_next"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Next ➔ (Step 2)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_poll_cancel"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="@drawable/bg_item_selector"
                android:focusable="true" />
        </LinearLayout>

        <!-- STEP 2 CONTAINER: Poll Settings & Quiz Options -->
        <LinearLayout
            android:id="@+id/layout_step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_poll_step2_question_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Q: "
                android:textColor="@color/focus_highlight_gold"
                android:textSize="12sp"
                android:textStyle="italic"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_poll_anonymous_toggle"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="☑ Anonymous Voting: ON"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_item_selector"
                android:focusable="true"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_poll_mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Poll Type: 📊 Regular Survey"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_item_selector"
                android:focusable="true"
                android:layout_marginBottom="6dp" />

            <!-- Quiz Mode Settings Container -->
            <LinearLayout
                android:id="@+id/layout_quiz_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Correct Answer:"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/btn_poll_correct_choice"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="Correct Answer: 1. Option 1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:background="@drawable/bg_item_selector"
                    android:focusable="true"
                    android:layout_marginBottom="6dp" />

                <com.teleflip.app.ui.LabeledInputView
                    android:id="@+id/liv_poll_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:inputLabel="Explanation (shown after voting):"
                    app:inputHint="Add explanation (optional)..."
                    app:inputSingleLine="true" />
            </LinearLayout>

            <!-- Regular Poll Settings Container -->
            <LinearLayout
                android:id="@+id/layout_regular_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_poll_multiple_answers_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="☐ Multiple Answers: OFF"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:background="@drawable/bg_item_selector"
                    android:focusable="true"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_poll_submit"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="📊 Send Poll"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_poll_back"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="◀ Back to Question"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="@drawable/bg_item_selector"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
