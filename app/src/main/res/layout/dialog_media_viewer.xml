<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top Overlay Header -->
    <LinearLayout
        android:id="@+id/layout_viewer_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tv_viewer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📷 Photo Viewer"
            android:textColor="@color/focus_highlight_gold"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_viewer_zoom_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="@color/text_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />

    </LinearLayout>

    <!-- Main Media Viewport -->
    <FrameLayout
        android:id="@+id/layout_viewer_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <ImageView
            android:id="@+id/iv_viewer_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_photo_attachment"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/vv_viewer_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_viewer_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Media file not yet downloaded"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite" />

    </FrameLayout>

    <!-- Caption & Keypad Controls Footer -->
    <LinearLayout
        android:id="@+id/layout_viewer_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_dark_card"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_viewer_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Action Buttons Row for Touch & D-Pad Control -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_zoom_in"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="60dp"
                    android:text="Zoom +"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_zoom_out"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="60dp"
                    android:text="Zoom -"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_pan_left"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="60dp"
                    android:text="◀ Pan"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_pan_right"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="60dp"
                    android:text="Pan ▶"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="60dp"
                    android:text="Reset"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="60dp"
                    android:text="Save"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:clickable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_viewer_controls_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[LSK/2] Zoom • [D-Pad] Pan • [5] Reset • [1] Save • [RSK] Back"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
