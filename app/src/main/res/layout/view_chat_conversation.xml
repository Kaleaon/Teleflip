<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Conversation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark_card"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/iv_conv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="@string/cd_contact_avatar"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_conv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="TG"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:background="@drawable/bg_tab_indicator" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_conv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_conv_star_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp"
                    android:focusable="false"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_conv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="online"
                android:textColor="@color/online_indicator"
                android:textSize="11sp"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Unread / Info Indicator -->
        <TextView
            android:id="@+id/tv_conv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Info]"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:focusable="false" />

    </LinearLayout>

    <!-- Pinned Message Banner (Shown when chat has a pinned message) -->
    <LinearLayout
        android:id="@+id/layout_pinned_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark_card"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_pinned_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📌 Pinned message"
            android:textColor="@color/focus_highlight_gold"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Message History List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:scrollbars="vertical" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progress_messages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Jump to Bottom Button -->
        <Button
            android:id="@+id/btn_jump_to_bottom"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⬇ Jump to Bottom"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Reply / Edit Context Banner (Visible when replying to or editing a message) -->
    <LinearLayout
        android:id="@+id/layout_reply_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark_card"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reply_edit_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↩ Replying to message..."
            android:textColor="@color/focus_highlight_gold"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_cancel_reply_edit"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="40dp"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true" />

    </LinearLayout>

    <!-- Voice Recording Live Bar (Visible during Push-to-Talk) -->
    <LinearLayout
        android:id="@+id/layout_voice_recording"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2E1111"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_record_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recording... (Press OK to Stop &amp; Send)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Bottom Compose Box -->
    <LinearLayout
        android:id="@+id/layout_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark_card"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Input Mode Badge: Press # to cycle Abc -> 123 -> ABC -->
        <TextView
            android:id="@+id/tv_input_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:gravity="center"
            android:text="Abc"
            android:textColor="@color/focus_highlight_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_tab_indicator"
            android:layout_marginEnd="6dp" />

        <!-- Message Text Input Field -->
        <EditText
            android:id="@+id/et_message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="38dp"
            android:maxLines="3"
            android:hint="Type message (or use keypad)..."
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="@drawable/bg_edittext_selector"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Send Button -->
        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="54dp"
            android:text="Send"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:layout_marginStart="6dp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
