<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Proxy Server Settings"
            android:textColor="@color/focus_highlight_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_proxy_input_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode: abc"
            android:textColor="@color/tg_blue"
            android:textSize="11sp"
            android:paddingBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/softkey_divider"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_proxy_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_error"
            android:textSize="12sp"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive"
            android:layout_marginBottom="8dp" />

        <!-- Current Active Status -->
        <TextView
            android:id="@+id/tv_proxy_active_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Proxy Disabled"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Proxy Type Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proxy Type:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_proxy_type_socks5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="SOCKS5"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_proxy_type_mtproto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MTProto"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_item_selector"
                android:focusable="true"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Server Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server Host / IP:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/et_proxy_server"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. 192.168.1.1 or proxy.com"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_edittext_selector"
            android:inputType="text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="8dp" />

        <!-- Port Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Port:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/et_proxy_port"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="1080"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_edittext_selector"
            android:inputType="number"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="8dp" />

        <!-- SOCKS5 Credentials Group -->
        <LinearLayout
            android:id="@+id/layout_socks5_credentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username (Optional):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/et_proxy_username"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="Username"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_edittext_selector"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password (Optional):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/et_proxy_password"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="Password"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_edittext_selector"
                android:inputType="textPassword"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- MTProto Credentials Group -->
        <LinearLayout
            android:id="@+id/layout_mtproto_credentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MTProto Secret:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/et_proxy_secret"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="e.g. ee123456789012345678901234567890"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_edittext_selector"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_proxy_save_enable"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="⚡ Save &amp; Enable Proxy"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_proxy_disable"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="🚫 Disable Proxy"
            android:textColor="@color/text_error"
            android:textSize="12sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <!-- Saved Proxies List Container -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configured Proxy Servers:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/layout_saved_proxies_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_proxy_close"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Close"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</ScrollView>
