<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_message_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/layout_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="340dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_inbound_bubble">

        <!-- Sender Name (shown in group chats for inbound) -->
        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sender Name"
            android:textColor="@color/focus_highlight"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="2dp" />

        <!-- Forwarded Header -->
        <TextView
            android:id="@+id/tv_forwarded_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↪ Forwarded message"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone"
            android:layout_marginBottom="2dp" />

        <!-- Quoted Reply Preview -->
        <TextView
            android:id="@+id/tv_reply_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↩ Reply preview"
            android:textColor="@color/focus_highlight_gold"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:background="@drawable/bg_tab_indicator"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone"
            android:layout_marginBottom="3dp" />

        <!-- Media Attachment Indicator (e.g. [Photo], [Voice Note]) -->
        <TextView
            android:id="@+id/tv_media_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 [Photo]"
            android:textColor="@color/focus_highlight_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="2dp" />

        <!-- Container for Photo/Media Preview and Star Badge Overlay -->
        <FrameLayout
            android:id="@+id/layout_media_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp">

            <!-- Image Preview for Photos & Paid Media -->
            <ImageView
                android:id="@+id/iv_message_photo"
                android:layout_width="160dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_photo_attachment"
                android:visibility="gone" />

            <!-- Telegram Stars Badge Overlay -->
            <TextView
                android:id="@+id/tv_star_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⭐ 5 Stars"
                android:textColor="@color/focus_highlight_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Message Body Text -->
        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message content goes here..."
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Transcribe Button for Voice Messages -->
        <TextView
            android:id="@+id/btn_transcribe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔤 Transcribe"
            android:textColor="@color/focus_highlight"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_indicator"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp" />

        <!-- Transcript Text View -->
        <TextView
            android:id="@+id/tv_transcript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <!-- Emoji Reactions Row -->
        <TextView
            android:id="@+id/tv_reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👍 ❤️"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_tab_indicator"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_marginTop="3dp" />

        <!-- Meta Line: Time & Status Tick -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:20"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_read_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ✓✓"
                android:textColor="@color/focus_highlight"
                android:textSize="11sp"
                android:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
