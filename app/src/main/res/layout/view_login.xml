<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- App Logo & Title -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_teleflip_logo"
            android:contentDescription="TeleFlip Logo"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TeleFlip"
            android:textColor="@color/tg_blue"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telegram for Flip Phones"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Status / Instruction Banner -->
        <TextView
            android:id="@+id/tv_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your phone number with country code (e.g. +1...)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:padding="8dp"
            android:background="@drawable/bg_tab_indicator"
            android:layout_marginBottom="16dp" />

        <!-- Input Field Container -->
        <LinearLayout
            android:id="@+id/layout_login_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_input_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phone Number:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_login_input_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[#] Abc"
                    android:textColor="@color/focus_highlight_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_login_input"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="+1 555 123 4567"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_edittext_selector"
                android:inputType="textVisiblePassword"
                android:singleLine="true"
                android:maxLines="1"
                android:nextFocusDown="@+id/btn_login_submit"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

        <!-- QR Code Container -->
        <LinearLayout
            android:id="@+id/layout_qr_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_login_qr"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:contentDescription="QR Code for Login"
                android:background="@color/bg_dark_card"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_qr_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open Telegram on your smartphone -> Settings -> Devices -> Link Desktop Device, and scan this code."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_phone_login"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Log in with Phone Number"
                android:textColor="@color/tg_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_item_selector"
                android:focusable="true"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_login_submit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Send Code"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:nextFocusUp="@+id/et_login_input"
            android:nextFocusDown="@+id/btn_retry_connection"
            android:layout_marginBottom="12dp" />

        <!-- Retry Connection Button -->
        <Button
            android:id="@+id/btn_retry_connection"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Retry Connection"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusUp="@+id/btn_login_submit"
            android:nextFocusDown="@+id/btn_forgot_password"
            android:layout_marginBottom="12dp" />

        <!-- Forgot Password Button -->
        <Button
            android:id="@+id/btn_forgot_password"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Forgot Password"
            android:textColor="@color/tg_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusUp="@+id/btn_retry_connection"
            android:nextFocusDown="@+id/btn_reset_account"
            android:layout_marginBottom="12dp" />

        <!-- Reset Account Button -->
        <Button
            android:id="@+id/btn_reset_account"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Reset Account"
            android:textColor="@color/text_error"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusUp="@+id/btn_forgot_password"
            android:nextFocusDown="@+id/btn_use_sim_number"
            android:layout_marginBottom="12dp" />

        <!-- Detected SIM Number Button -->
        <Button
            android:id="@+id/btn_use_sim_number"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Use SIM Phone Number"
            android:textColor="@color/tg_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusUp="@+id/btn_login_submit"
            android:nextFocusDown="@+id/btn_qr_login"
            android:layout_marginBottom="12dp" />

        <!-- Switch to QR Login Button -->
        <Button
            android:id="@+id/btn_qr_login"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Log in with QR Code"
            android:textColor="@color/tg_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:visibility="visible"
            android:nextFocusUp="@+id/btn_use_sim_number"
            android:nextFocusDown="@+id/btn_login_proxy"
            android:layout_marginBottom="12dp" />

        <!-- Proxy Settings Button -->
        <Button
            android:id="@+id/btn_login_proxy"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Proxy Settings"
            android:textColor="@color/tg_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:visibility="visible"
            android:nextFocusUp="@+id/btn_qr_login"
            android:nextFocusDown="@+id/btn_config_credentials"
            android:layout_marginBottom="12dp" />

        <!-- Configure API Credentials Button -->
        <Button
            android:id="@+id/btn_config_credentials"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="API Credentials &amp; Settings"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@drawable/bg_item_selector"
            android:focusable="true"
            android:nextFocusUp="@+id/btn_login_proxy"
            android:layout_marginBottom="16dp" />

        <!-- Progress Spinner -->
        <ProgressBar
            android:id="@+id/progress_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
