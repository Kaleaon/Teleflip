<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="44sp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TeleFlip Passcode"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 4-digit PIN on the keypad"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_passcode_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○   ○   ○   ○"
        android:textColor="@color/tg_blue"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:accessibilityLiveRegion="polite"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_passcode_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_error"
        android:textSize="13sp"
        android:accessibilityLiveRegion="assertive"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_passcode_forgot"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Forgot Passcode? (Log Out)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:background="@drawable/bg_item_selector"
        android:focusable="true" />

</LinearLayout>
